@startuml
title Laufzeitsicht – Analyse, Fehler und Retry

autonumber
actor Ingenieur as User
participant "analysis-management-service" as Management
participant "configuration-service" as Configuration
participant "fluid-analysis-service" as Fluid
participant "thermal-analysis-service" as Thermal
participant "electrical-analysis-service" as Electrical
participant "engine-management-analysis-service" as Engine

User -> Management : POST /api/analyses\n(configurationId)
Management -> Configuration : GET /api/configurations/{id}
Configuration --> Management : Engine Configuration
Management -> Management : AnalysisRun anlegen\nFLUID = RUNNING
Management -> Fluid : POST /internal/analyses
Management --> User : 202 Accepted + analysisId

Fluid -> Management : RUNNING
Fluid -> Fluid : Analyse simulieren
Fluid -> Management : READY / OK
Fluid -> Thermal : POST /internal/analyses

alt Thermal erreichbar
    Thermal -> Management : RUNNING
    Thermal -> Thermal : Analyse simulieren
    Thermal -> Management : READY / OK
    Thermal -> Electrical : POST /internal/analyses

    Electrical -> Management : RUNNING
    Electrical -> Electrical : Analyse simulieren
    Electrical -> Management : READY / OK
    Electrical -> Engine : POST /internal/analyses

    Engine -> Management : RUNNING
    Engine -> Engine : Konfiguration + previousResults prüfen
    Engine -> Management : READY / OK
    Management -> Management : overallResult = OK
else Thermal nicht erreichbar
    Fluid -> Fluid : Circuit Breaker / Fallback
    Fluid -> Management : THERMAL = FAILED
    Management -> Management : overallResult = FAILED

    User -> Management : POST .../THERMAL/retry
    Management -> Thermal : POST /internal/analyses
    Management --> User : 202 Accepted
    Thermal -> Management : RUNNING
    Thermal -> Management : READY / OK
    Thermal -> Electrical : Choreographie fortsetzen
    Electrical -> Engine : Choreographie fortsetzen
    Engine -> Management : READY / OK
    Management -> Management : overallResult = OK
end

User -> Management : GET /api/analyses/{analysisId}
Management --> User : Status + Einzelresultate + Overall Result

@enduml
